# Upstash Redis connection string (rediss:// — note the double "s" for TLS).
#
# Get it from either:
#   - Vercel dashboard -> Storage -> Redis (Upstash) -> .env.local tab
#   - console.upstash.com -> your database -> "Redis Connect" -> ioredis
#
# If this is left unset, nullchat starts in SINGLE-INSTANCE mode: an in-process
# event bus stands in for Redis Pub/Sub so you can run and test locally with
# zero setup. That mode does NOT synchronise across Vercel instances — set a
# real URL before deploying anything you expect more than one person to use.
REDIS_URL="rediss://default:YOUR_UPSTASH_PASSWORD@your-db-name.upstash.io:6379"

# Local dev port (ignored on Vercel).
PORT=3000
